{
  "name": "rubric",
  "version": "1.0.0",
  "private": true,
  "description": "A weighted report card for any URL — security headers and page quality, measured in a browser sandbox on Tencent EdgeOne Makers",
  "author": "Ravi Arnan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ravi-arnan/rubric.git"
  },
  "homepage": "https://edgeone-site-auditor.edgeone.dev",
  "bugs": {
    "url": "https://github.com/ravi-arnan/rubric/issues"
  },
  "keywords": [
    "edgeone",
    "tencent-edgeone-makers",
    "security-headers",
    "site-audit",
    "browser-sandbox",
    "nextjs",
    "agent"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"agents/**/*.test.ts\"",
    "audit:stub": "node agents/audit/stub.ts",
    "dev:stub": "NEXT_PUBLIC_AUDIT_ENDPOINT=http://localhost:3002/audit next dev --webpack",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
